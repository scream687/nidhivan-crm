{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Lives at the repo root, not in apps/web, so Cloudflare Workers Builds finds
  // it with a bare `npx wrangler deploy` from the root directory — no --config
  // flag and no dashboard change required.
  //
  // Must match the existing Worker so deploys update it rather than creating a
  // second one alongside it.
  "name": "nidhivan-crm",

  "main": "apps/web/.open-next/worker.js",
  "compatibility_date": "2026-08-15",

  // Required by OpenNext: the generated worker pulls in Node built-ins.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "apps/web/.open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Declared here rather than only in the dashboard, so the hostname binding is
  // reviewable and survives a rebuild.
  "routes": [
    { "pattern": "crm.nidhivanproperty.com", "custom_domain": true }
  ]
}
