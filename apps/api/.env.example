DATABASE_URL=postgresql://nidhivan:nidhivan_secret@localhost:5432/nidhivan_crm
REDIS_URL=redis://localhost:6379
JWT_SECRET=your_very_long_random_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# API_URL is used to build the webhook URLs handed to Exotel — it must be the
# publicly reachable origin in production, not localhost.
API_URL=http://localhost:4000

# ─── Integrations ────────────────────────────────────────────────────────────
# Everything below is a FALLBACK ONLY. Values saved through Settings →
# Integrations / Telephony are stored in the database and take precedence.
# Prefer the UI: it keeps secrets out of the deploy environment and lets a
# non-developer rotate them.

# Exotel. Note the API Key and API Token are a separate credential pair from
# the Account SID — Exotel authenticates with key:token, the SID is path-only.
EXOTEL_API_KEY=
EXOTEL_TOKEN=
EXOTEL_SID=
EXOTEL_VIRTUAL_NUMBER=
# Region-pinned: api.exotel.com (Singapore) or api.in.exotel.com (Mumbai)
EXOTEL_SUBDOMAIN=api.exotel.com

# Facebook Lead Ads. Without FB_APP_SECRET every inbound webhook is rejected —
# the CRM verifies the X-Hub-Signature-256 Facebook signs each delivery with.
FB_APP_SECRET=
FB_VERIFY_TOKEN=
FB_PAGE_ACCESS_TOKEN=
